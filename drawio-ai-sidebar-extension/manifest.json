{
  "manifest_version": 3,
  "name": "Draw.io AI Sidebar",
  "version": "0.1.0",
  "description": "AI sidebar for app.diagrams.net: natural language to draw.io XML with direct canvas injection.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://app.diagrams.net/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.diagrams.net/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Draw.io AI Sidebar"
  }
}
